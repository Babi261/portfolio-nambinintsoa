520 0 obj
  << /ActualText (Hello\041 My name is Nambinintsoa\054 but you can call me Babi\056 I\031m 24 years old and from Madagascar\056 I\031m currently an au pair in Belgium\054 where I take care of two wonderful children aged 5 and 8\056)
     /K [ 4 ]
     /P 521 0 R
     /Pg 512 0 R
     /S /Span
     /Type /StructElem
  >>
endobj

521 0 obj
  << /K [ 520 0 R ]
     /P 550 0 R
     /S /P
     /Pg 512 0 R
     /Type /StructElem
  >>
endobj

522 0 obj
  << /ActualText (I\031m a calm\054 caring and reliable person\054 but I also enjoy being active and discovering new things\056 I\031m interested in languages\054 different cultures\054 travelling and technology\056 Living abroad has been a great experience for me\054 and I would love to continue this journey with a new host family\056)
     /K [ 5 ]
     /P 523 0 R
     /Pg 512 0 R
     /S /Span
     /Type /StructElem
  >>
endobj

523 0 obj
  << /K [ 522 0 R ]
     /P 550 0 R
     /S /P
     /Pg 512 0 R
     /Type /StructElem
  >>
endobj

524 0 obj
  << /ActualText (My current au pair experience has taught me a lot about childcare and family life\056 I help with the children\031s daily routines\054 prepare meals\054 keep things tidy\054 and help with school drop\055offs and pick\055ups\056 I really enjoy spending time with the children after school\054 whether it\031s playing together\054 going outside\054 or simply talking about their day\056 I\031m patient and attentive\054 while also giving children space to be themselves\056)
     /K [ 6 ]
     /P 525 0 R
     /Pg 512 0 R
     /S /Span
     /Type /StructElem
  >>
endobj

525 0 obj
  << /K [ 524 0 R ]
     /P 550 0 R
     /S /P
     /Pg 512 0 R
     /Type /StructElem
  >>
endobj

526 0 obj
  << /ActualText (Before becoming an au pair\054 I also gained experience in a school environment through an internship\056 I have basic first\055aid training and I\031m comfortable with everyday household tasks\056 I can also drive\054 which I know can be helpful for a family with children\056)
     /K [ 7 ]
     /P 527 0 R
     /Pg 512 0 R
     /S /Span
     /Type /StructElem
  >>
endobj

527 0 obj
  << /K [ 526 0 R ]
     /P 550 0 R
     /S /P
     /Pg 512 0 R
     /Type /StructElem
  >>
endobj

528 0 obj
  << /ActualText (I speak French and English\054 and I\031m currently learning German\056 I enjoy learning languages and discovering different cultures\054 and I would be happy to share my Malagasy culture\054 food and traditions with my host family too\056)
     /K [ 8 ]
     /P 529 0 R
     /Pg 512 0 R
     /S /Span
     /Type /StructElem
  >>
endobj

529 0 obj
  << /K [ 528 0 R ]
     /P 550 0 R
     /S /P
     /Pg 512 0 R
     /Type /StructElem
  >>
endobj

530 0 obj
  << /ActualText (For my next au pair experience\054 I\031m looking for a friendly and open\055minded family where we can communicate easily and build a good relationship based on trust and respect\056 I\031m happy to learn your routines and adapt to your family\031s way of life\056)
     /K [ 9 ]
     /P 531 0 R
     /Pg 512 0 R
     /S /Span
     /Type /StructElem
  >>
endobj

